var bg:FlxSprite;

function onCreate()
{
    trace('created script');
    	
	bg = CoolUtil.blankSprite(FlxG.width, FlxG.height, 0xFFB3DFd8);
	bg.camera = game.camOther;
	bg.alpha = 0;
	game.add(bg);
	new FlxTimer().start(0.83, function(tmr:FlxTimer)
	{
		bg.alpha += (1 / 5) * 0.7;
		if (bg.alpha > 0.7)
			bg.alpha = 0.7;
	}, 5);

    var handSelect:FlxSprite = new FlxSprite(1100, 600).loadGraphic(Paths.image('pixelUI/hand_textbox'));
	handSelect.setGraphicSize(Std.int(handSelect.width *4));
	handSelect.updateHitbox();
    handSelect.antialiasing = false;
    handSelect.cameras = [game.camOther];
	game.add(handSelect);
    trace(handSelect.active);

}

function onCountdownStarted() {
	FlxG.sound.music.fadeOut(1.5, 0, (_) -> FlxG.sound.music.stop());

	new FlxTimer().start(0.2, function(tmr:FlxTimer)
	{
		bg.alpha -= 1 / 5 * 0.7;
	}, 5);
}
