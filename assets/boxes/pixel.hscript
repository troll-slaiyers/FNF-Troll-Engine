var bg:FlxSprite;
var handSelect:FlxSprite;
var alphaIn:FlxTimer;
function onCreate()
{
    trace('created script');
    	
	bg = CoolUtil.blankSprite(FlxG.width, FlxG.height, 0xFFB3DFd8);
	bg.camera = game.camOther;
	bg.alpha = 0;
	game.add(bg);
	
	alphaIn = new FlxTimer().start(0.83, function(tmr:FlxTimer)
	{
		bg.alpha += (1 / 5) * 0.7;
		if (bg.alpha > 0.7)
			bg.alpha = 0.7;
	}, 5);

    handSelect = new FlxSprite(1100, 600).loadGraphic(Paths.image('pixelUI/hand_textbox'));
	handSelect.setGraphicSize(Std.int(handSelect.width *4));
	handSelect.updateHitbox();
    handSelect.antialiasing = false;
    handSelect.cameras = [game.camOther];
	game.add(handSelect);
	
    trace(handSelect.active);

}

function onDialogueEnded() {
	if(alphaIn!= null)alphaIn.cancel();
	handSelect.visible = false;	
	new FlxTimer().start(0.2, function(tmr:FlxTimer)
	{
		bg.alpha -= 1 / 5 * 0.7;
	}, 5);
}
